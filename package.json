{
    "name": "mec-map",
    "version": "1.1.0",
    "description": "",
    "license": "MIT",
    "main": "src/main.ts",
    "packageManager": "yarn@1.22.22",
    "scripts": {
        "test": "ts-node --transpile-only scripts/test.ts",
        "test-launch": "ts-node --transpile-only scripts/test.ts --launch",
        "test-no-launch": "ts-node --transpile-only scripts/test.ts --no-launch",
        "test-memory-handler": "set \"SCRIPT=test-memory-handler\" && yarn test-no-launch && ts-node scripts/debug-memory-handler.ts && yarn test-launch",
        "build": "ts-node --transpile-only scripts/build.ts",
        "generate-help": "ts-node --transpile-only scripts/generate-help-docs.ts",
        "deploy": "ts-node --transpile-only scripts/deploy.ts",
        "release": "yarn build && php ./bin/wrapLUAforWE.php",
        "release-test": "yarn release && ts-node scripts/releaseTest.ts",
        "release-test-memory-handler": "set \"SCRIPT=test-memory-handler\" && yarn build && ts-node scripts/debug-memory-handler.ts \"./dist/tstl_output_extended.lua\" && php ./bin/wrapLUAforWE.php && ts-node scripts/releaseTest.ts",
        "release-test-publish": "yarn release && ts-node scripts/releaseTest.ts --publish",
        "dev": "npm-watch",
        "build:defs": "ts-node scripts/dev",
        "prepare": "husky"
    },
    "dependencies": {
        "dotenv": "^17.2.3",
        "w3ts": "^3.0.2"
    },
    "devDependencies": {
        "@types/fs-extra": "11.0.4",
        "@types/node": "24.1.0",
        "@types/pako": "2.0.4",
        "fs-extra": "11.3.2",
        "get-all-files": "^6.0.0",
        "husky": "^9.1.7",
        "jass-to-ts": "^1.2.5",
        "lua-types": "^2.13.1",
        "luamin": "^1.0.4",
        "mdx-m3-viewer-th": "^5.13.4",
        "npm-watch": "0.13.0",
        "prettier": "^3.7.4",
        "ts-node": "10.9.2",
        "tsconfig-paths": "4.2.0",
        "tsutils": "3.21.0",
        "typescript": "5.9.3",
        "typescript-to-lua": "1.33.0",
        "war3-objectdata-th": "^0.2.11",
        "war3-transformer": "^3.0.10",
        "war3-types-strict": "^0.1.3",
        "war3tstlhelper": "1.0.1",
        "winston": "^3.19.0"
    },
    "watch": {
        "build:defs": {
            "patterns": [
                "./maps/*"
            ],
            "extensions": "lua",
            "legacyWatch": true
        }
    }
}
